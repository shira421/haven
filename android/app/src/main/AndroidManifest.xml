<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The Haven server: accounts and friends -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The background check for friends' news waits for a connection; Android 14 requires this for that -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- "Your fern is fully grown" and the daily reminder (only when you allow it) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets the end-of-session notification arrive on time where the phone allows exact alarms -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <!-- From Android 13, exact timing for alarms is asked for this way. Without it Android may hold
         a notification back for minutes, too late for "come back to Haven" or the end of a session. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Puts the daily reminder back after the phone restarts, and keeps the friends check scheduled -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Haven"
        android:supportsRtl="true"
        android:theme="@style/Theme.Haven"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Back from the browser after signing in with Google -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="haven" android:host="auth" />
            </intent-filter>
        </activity>
        <!-- Checks for friend requests, invitations, cheers and gifts while Haven is closed -->
        <service
            android:name=".Inbox"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <receiver android:name=".Notifier" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
