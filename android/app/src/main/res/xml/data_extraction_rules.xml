<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing is copied off the phone: a Haven account keeps the haven on the server, and the sign-in
     on this phone should not move to another one by itself. Signing in there brings everything back. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
