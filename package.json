{
  "name": "haven",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Haven: a focus timer that grows a sanctuary of plants and animals, with live friends.",
  "scripts": {
    "start": "node server.mjs",
    "build": "node build.mjs",
    "pretest": "npm run build",
    "test": "node --test tests/core.test.mjs tests/store.test.mjs tests/catalog.test.mjs tests/world.test.mjs tests/timer.test.mjs tests/hub.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:rig": "node tests/rig.mjs",
    "icons": "node scripts/make-icons.mjs",
    "media": "MEDIA=1 node tests/browser.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "esbuild": "0.28.2",
    "miniflare": "4.20260730.0",
    "playwright-core": "1.65.1"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/figtree": "5.3.0"
  }
}
